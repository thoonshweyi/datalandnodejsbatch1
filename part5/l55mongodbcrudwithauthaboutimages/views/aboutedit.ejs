<!DOCTYPE html>
<html lang="en">
<%- include('./layout/head.ejs')  %>
<body>
    <%- include('./layout/nav.ejs')  %>

    <div class="container">
        <div>
            <h1><%= title %></h1>

            <!-- Server Error -->
            <% if(error){ %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <!-- Client Error -->
            <div id="clientError" class="alert alert-danger d-none">Error</div>
        </div>

        <div>
                <form id="aboutEditForm" action="/about/edit" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="" class="form-label">Page Title</label>
                        <!-- <input type="text" name="title" id="title" value="<%= aboutpage ? aboutpage.title : '' %>"> -->
                        <input type="text" name="title" id="title"  class="form-control" value="<%= aboutpage.title || '' %>">
                    </div>

                    <div class="mb-3">
                        <label for="body" class="form-label">About Body</label>
                        <textarea name="body" id="body"  class="form-control"><%= aboutpage ? aboutpage.body : '' %></textarea>
                    </div>

                    <!-- Current Images -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="fa-solid fa-images me-1"></i> Current Photos
                            </h6>

                            <span class="badge text-bg-secondary">
                                <span id="totalImageCount">
                                    <%= aboutpage.imageurls?.length || 0 %>
                                </span> / <%= maxImages || 5 %>
                            </span>
                        </div>

                         <% if(aboutpage.imageurls && aboutpage.imageurls.length > 0){ %>
                            <div id="existingImagesGrid" class="row g-3 mb-3">
                                <% aboutpage.imageurls.forEach(imageurl =>{ %>
                                    <div class="col-6 col-md-4 col-lg-3 existing-image-card" data-image-url="<%= imageurl %>">
                                        <div class="card h-100 shadow-sm">
                                            <img src="<%= imageurl %>" class="card-img-top" style="height: 150px; object-fit: cover;" alt="current image">
                                                
                                            <div class="card-body p-2">
                                                <button type="button" class="w-100 btn btn-outline-danger btn-sm remove-existing-btn">
                                                    <i class="fa-solid fa-trash me-1"></i>Remove
                                                </button>
                                            </div>
                                        </div>
                                    
                                    </div>
                                <% }) %>
                            </div>
                        <% }else { %>
                            <div class="alert alert-light border">
                                <i class="fa-regular fa-image me-2"></i> No current images.
                            </div>
                        <% } %>

                        <!-- Javascript will add remove Images inputs -->
                        <div id="removeImageInputs"></div>
                    </div>

                    <hr/>

                    <!-- Upload Box -->
                    <div class="mb-4">
                        <label for="" class="form-label fw-semibold">Add New Photos</label>

                        <!-- upload card -->
                        <label for="images" class="card bg-light text-center border-2 shadow-sm" role="button">
                            <div class="card-body py-5">
                                <div class="mb-3">
                                    <span class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center p-4">
                                        <i class="fa-solid fa-cloud-arrow-up fa-2x text-primary"></i>
                                    </span>
                                </div>

                                <h5 class="mb-2">Upload Photos</h5>
                                <div class="text-muted mb-3">You can upload up to 5 images at once.</div>
                                <span class="btn btn-primary">
                                    <i class="fa-solid fa-images me-2"></i> Choose Photos
                                </span>

                                <div class="mt-3">
                                    <small class="text-muted d-block">JPG, PNG, WEP or other image files</small>
                                    <small class="text-muted d-block">Maximum 2 MB per image</small>
                                    <small class="text-muted d-block">Maximum <%= maxImages || 5 %> photos total</small>
                                </div>

                            </div>
                            
                        </label>

                        <!-- File Input -->
                        <input type="file" name="images" id="images" class="d-none form-control" accept="image/*" multiple>
                    
                        <!-- Selected Information -->
                        <div id="selectedFileInfo" class="d-none alert alert-primary mt-3 mb-0">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-circle-check me-2"></i>
                                <strong id="selectedFileCount">0</strong> photo(s) selected
                            </div>
                        </div>


                    </div>

                    <!-- New Images Preview -->
                     <div id="newImageSection" class="d-none mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="fa-solid fa-images me-1"></i> New Photos
                            </h6>

                            <span class="badge text-bg-primary">
                                <span id="newImageCount">0</span> selected
                            </span>
                        </div>

                        <div id="newImagesGrid" class="row g-3"></div>
                     </div>

                     <!-- Upload Progress -->
                      <div id="uploadStatus" class="card d-none shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span id="uploadStatusText">Preparing upload....</span>
                                <strong id="uploadPercent">0%</strong>
                            </div>

                            <div class="progress">
                                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 20%;"></div>
                            </div>
                        </div>
                      </div>

                 
                    <div class="d-flex justify-content-end gap-2">
                        <a href="/about" class="btn btn-secondary">Cancel</a>
                        <button type="submit" id="submitBtn" class="btn btn-primary">Update</button>
                    </div>
                </form>
        </div>
    </div>


    
    <%- include('./layout/footer.ejs')  %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        const MAX_IMAGES = <%= maxImages || 5 %>; // number data type
        const MAX_FILE_SIZE = 2 * 1024 * 1024;  // 2MB
        
        const aboutEditForm = document.getElementById('aboutEditForm');
        const imagesInput = document.getElementById('images');

        const existingImagesGrid = document.getElementById('existingImagesGrid');

        const newImageSection = document.getElementById('newImageSection');
        const newImagesGrid = document.getElementById('newImagesGrid');
        const removeImageInputs = document.getElementById('removeImageInputs');
        const newImageCount = document.getElementById('newImageCount');
        const totalImageCount = document.getElementById('totalImageCount');

        const selectedFileInfo = document.getElementById('selectedFileInfo');
        const selectedFileCount = document.getElementById('selectedFileCount');
        
        const clientError = document.getElementById('clientError');

        const uploadStatus = document.getElementById('uploadStatus');
        const uploadPercent = document.getElementById('uploadPercent');
        const uploadStatusText = document.getElementById('uploadStatusText');
        const uploadProgressBar = document.getElementById('uploadProgressBar');

        const submitBtn = document.getElementById('submitBtn');

        // state
        let selectedFiles = [];
        const removeExistingImages = new Set();

        imagesInput.addEventListener('change',()=>{
            // console.log(imagesInput.files); // FileList {0: File, length: 1}
            // console.log(Array.from(imagesInput.files)); // [File]

            addFiles(Array.from(imagesInput.files));
        });

        function addFiles(files){
            // console.log(files); // (4) [File, File, File, File]

            hideError();

            for(const file of files){
                console.log(file);

                // must be image
                if(!file.type.startsWith('image/')){
                    showError(`${file.name} is not an image.`);
                    continue;
                }

                // file size (2mb)
                if(file.size > MAX_FILE_SIZE){
                    showError(`${file.name} is larger than 2 M`);
                    continue;
                }

                // prevent duplicate 
                const duplicate = selectedFiles.some(
                    (selectedFile)=> selectedFile.name === file.name &&
                                    selectedFile.size === file.size &&
                                    selectedFile.lastModified === file.lastModified
                );
                
                if(duplicate){
                    continue;
                }

                // Maximum total images
                if(getFinalImageCount() >= MAX_IMAGES){
                    showError(`Maximum ${MAX_IMAGES} images are allowed.`);
                    break;
                }
                
                selectedFiles.push(file);
            }

            renderNewImages();
            updateCounter();
        }

        function showError(message){
            clientError.textContent = message;
            clientError.classList.remove('d-none');

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        function hideError(){
            clientError.textContent = "message";
            clientError.classList.add('d-none');
        }


        function renderNewImages(){
            newImagesGrid.innerHTML = "";

            if(selectedFiles.length === 0){
                newImageSection.classList.add('d-none');
                return;
            }

            newImageSection.classList.remove('d-none');
            
            selectedFiles.forEach((selectedFile,index)=>{
                const imageURL = URL.createObjectURL(selectedFile);

                const columndiv = document.createElement('div');

                columndiv.className = "col-6 col-lg-3 col-md-4";

                columndiv.innerHTML = `
                    <div class="card h-100 shadow-sm">
                        <img src="${imageURL}" class="card-img-top" style="height:150px;object-fit:cover" alt="New image preview" />
                        
                        <div class="card-body p-2">
                            <div class="small text-trancate mb-2" title="${escapseHtml(selectedFile.name)}">
                                ${escapseHtml(selectedFile.name)}
                            </div>

                            <div class="small text-muted mb-2">
                                ${formatFileSize(selectedFile.size)}
                            </div>

                            <button type="button" class="w-100 btn btn-outline-danger btn-sm">
                                <i class="fa-solid fa-trash me-1"></i>Remove
                            </button>
                        </div>
                    </div>
                `;

                columndiv.querySelector("img").addEventListener("load",()=>{
                    URL.revokeObjectURL(imageURL); // remove from memory blob
                },{
                    once: true // we just wanna use only 1 times after load Event
                });

                columndiv.querySelector("button").addEventListener("click",()=>{
                    URL.revokeObjectURL(imageURL);

                    removeNewImage(index);
                    
                });

                newImagesGrid.appendChild(columndiv);

            });

        }

        // Remove New Image
        function removeNewImage(index){
            selectedFiles.splice(index,1); // (index, remove count)

            renderNewImages();
            updateCounter();
        }

        
        // Remove Existing Image & Undo
        document.querySelectorAll('.remove-existing-btn').forEach(extremovebutton=>{
            extremovebutton.addEventListener('click',()=>{
                const card = extremovebutton.closest('.existing-image-card');

                const getimageurl = card.dataset.imageUrl;
                // console.log(getimageurl);

                // Undo
                if(removeExistingImages.has(getimageurl)){
                    removeExistingImages.delete(getimageurl);

                    card.classList.remove('opacity-50');
                    extremovebutton.classList.remove('btn-warning');
                    extremovebutton.classList.add('btn-outline-warning');

                    extremovebutton.innerHTML = `<i class="fa-solid fa-trash me-1"></i> Remove`;
                }else{
                    removeExistingImages.add(getimageurl);

                    card.classList.add('opacity-50');
                    extremovebutton.classList.add('btn-warning');
                    extremovebutton.classList.remove('btn-outline-warning');

                    extremovebutton.innerHTML = `<i class="fa-solid fa-rotate-left me-1"></i> Undo`;
                }

                // console.log(removeExistingImages);

                renderRemoveInputs();
                updateCounter();
            });
        })

        function renderRemoveInputs(){
            removeImageInputs.innerHTML = "";

            removeExistingImages.forEach(imageurl =>{
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "removeImages";
                input.value = imageurl;

                removeImageInputs.appendChild(input);
            });
        }

        function getFinalImageCount(){
            // return document.querySelectorAll('.existing-image-card').length + selectedFiles.length;

            // const imageurlsCount = <%- JSON.stringify(aboutpage.imageurls?.length) %>;
            // return  imageurlsCount + selectedFiles.length;

            return (document.querySelectorAll('.existing-image-card').length - removeExistingImages.size) + selectedFiles.length;
        }

        function updateCounter(){
            totalImageCount.textContent = getFinalImageCount();
            newImageCount.textContent = selectedFiles.length;
            selectedFileCount.textContent = selectedFiles.length;
            
            if(selectedFiles.length > 0){
                selectedFileInfo.classList.remove('d-none');
            }else{
                selectedFileInfo.classList.add('d-none');
            }
        }
        updateCounter();

        // Form Submit with Upload Progress
        aboutEditForm.addEventListener("submit",(e)=>{
            e.preventDefault();

            hideError();

            // HTML Valication (checkValidity() = require, minlength, maxlength, type="email" type="number")
            if(!aboutEditForm.checkValidity()){
                aboutEditForm.reportValidity(); // show input UI error message
                return;
            }

            // Maximum image validation
            if(getFinalImageCount() > MAX_IMAGES){
                showError(`Maximum ${MAX_IMAGES} images are allowed.`); 
                return ;
            }

            const formData = new FormData(aboutEditForm);
            const xhr = new XMLHttpRequest();

            setUploadingState();

            xhr.open("POST",aboutEditForm.action,true); // true = Asynchronous

            xhr.upload.addEventListener("progress",(event)=>{
                // console.log(event); // ProgressEvent {isTrusted: true, lengthComputable: true, loaded: 23888, total: 23888, type: 'progress', …}

                if(!event.lengthComputable) return;
                
                const percent = Math.round((event.loaded / event.total) * 100);
                uploadProgressBar.style.width = `${percent}%`;
                uploadPercent.textContent = `${percent}%`;

                if(percent < 100){
                    uploadStatusText.textContent = selectedFiles.length > 0 ? `Uploading ${selectedFiles.length} image(s)...` : "Updating About Page....";
                }else{
                    uploadStatusText.textContent = "Updating complete";
                }
            });

            xhr.addEventListener("load",(event)=>{
                
                if(xhr.status >= 200 && xhr.status < 400){
                    window.location.assign("/about");
                    return;
                }

                showError(`About Page update failed.`);

                resetUploadState();
            });

            xhr.addEventListener("error",(event)=>{
                showError(`Upload failed, Please check your network connection.`);

                resetUploadState();
            });

            // Send Request
            xhr.send(formData);
        });

        function setUploadingState(){
            uploadStatus.classList.remove('d-none');
            uploadProgressBar.style.width = '0%';
            uploadPercent.textContent = '0%';
            uploadStatusText.textContent = "Preparing upload....";
            
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Updating...`;

            uploadStatus.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

        function resetUploadState(){
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<i class="fa-solid fa-floppy-disk me-1"></i> Update`;
            uploadStatus.classList.add('d-none');
        }

        function formatFileSize(bytes){
            if(bytes < 1024){
                return `${bytes} B`;
            }

            if(bytes < 1024 * 1024){
                return `${(bytes / 1024).toFixed(1)} KB`;
            }

            return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
        }

        // helper
        function escapseHtml(text){
            return String(text)
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#39;");
        }
    </script>
</body>
</html>





