<!DOCTYPE html>
<html lang="en">
<%- include('./layout/head.ejs')  %>
<body>
    
    <%- include('./layout/nav.ejs')  %>

    <div class="container">
        <div>
            <h2>Latest Blog Posts</h2>
            <p class="text-muted">Total posts: <%= total %></p>
        </div>

        <!-- search -->
        <!-- <form class="mb-3" action="" method="GET">
            <div class="input-group">
                <input type="text" name="q" class="form-control" placeholder="Search posts...." value="<%= q || '' %>"/>
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <% if(q){ %>
                    <a href="/" class="btn btn-online-secondary">Clear</a>
                <% } %>
            </div>
        </form> -->

        <!-- Search Suggestion -->
        <form class="mb-3 position-relative" action="" method="GET" autocomplete="off" >
            <div class="input-group">
                <input type="text" name="q" id="searchinput" class="form-control" placeholder="Search posts...." value="<%= q || '' %>"/>
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <% if(q){ %>
                    <a href="/" class="btn btn-online-secondary">Clear</a>
                <% } %>
            </div>

            <div id="suggestionbox" class="position-absolute list-group w-100 shadow" style="z-index: 100; display: none;"></div>
        </form>

        <% if(posts.length > 0){ %>
            <% posts.forEach(post=>{ %>


                <h3>
                    <a href="/posts/<%= post.slug %>" style="text-decoration: none;"><%= post.title %></a>
                </h3>

                <small>Posted: <%= post.createdAt ? new Date(post.createdAt).toLocaleString() : "Unknown date" %></small>
                
                <h5><%= post.subtitle %></h5> 

                <p><%= post.body %></p>
                    <% if(currentuser){ %>
                       <a href="/posts/<%= post._id %>/edit" class="btn btn-sm btn-primary"><i class="fa-solid fa-pen-to-square"></i></a>
                        <form class="d-inline" action="/posts/<%= post._id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure to delete this post?')">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    <% } %>
                <hr/>
            <% }) %>

        <% }else{ %>
            <p>Thre are no blog posts to display.</p>
            <a href="/posts/create">Create First Post</a>
        <% } %>
     
        <!-- Pagination -->
        <!-- http://localhost:3000/?page=2 -->
        <!-- http://localhost:3000/?q=three --> <!-- http://localhost:3000/?q=post+three --> 
        <div class="d-flex justify-content-center align-items-center gap-2 mt-4">
            <!-- http://localhost:3000/?q=post%40three -->

            <% if(page > 1){ %>
                <a href="/?page=<%= page - 1 %><%= q? `&q=${encodeURIComponent(q)}` : '' %>" class="btn btn-outline-secondary">
                    Prev
                </a>
            <% }  %>
            <span class="text-muted"><%= page %> / <%= totalpages %> </span>
            <% if(page < totalpages){ %>
                <a href="/?page=<%= page + 1 %><%= q? `&q=${encodeURIComponent(q)}` : '' %>" class="btn btn-outline-secondary">
                    Next
                </a>
            <% }  %>
        </div>

    </div>

    <%- include('./layout/footer.ejs')  %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script type="text/javascript">
        const searchInput = document.getElementById('searchinput');
        const suggestionBox = document.getElementById('suggestionbox');

        let searchTimer = null;

        searchInput.addEventListener("input", function(){
            const keyword = this.value.trim();

            clearTimeout(searchTimer);

            if(!keyword){
                suggestionBox.innerHTML = ""
                suggestionBox.style.display = "none";
                return;
            }

            searchTimer = setTimeout(async function(){
                try{
                    const response = await fetch(`/api/search-suggestions?q=${encodeURIComponent(keyword)}`)
                    const result = await response.json();
                    console.log(result);

                    if(!result.success || result.suggestions.length === 0){
                        suggestionBox.innerHTML = `<div class="list-group-item text-muted">No suggestions found.</div>`;
                        suggestionBox.style.display = "block";
                    }

                    suggestionBox.innerHTML = result.suggestions.map(post=>`<a href="/posts/${escapseHtml(post.slug)}" class="list-group-item list-group-item-action">
                        <div class="fw-bold">${escapseHtml(post.title)}</div>
                        <small class="text-muted">${escapseHtml(post.title || "")}</small>
                    </a>`).join("")
                    suggestionBox.style.display = "block";
                }catch(error){
                    console.log("Suggestion error: ",error);
                }
            },300)

        })

        // hide suggestion box when click outside
        document.addEventListener("click",function(e){
            if(!e.target.closest('form')){
                suggestionBox.style.display = 'none';
            }
        });

         // helper
        function escapseHtml(text){
            return String(text)
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#39;");
        }
    </script>
</body>
</html>

<!-- Encode characters such as ?= / & : @ + $ # -->
<!-- encodeURIComponent("text?") -->
<!-- console.log(`?x=${encodeURIComponent("text?")}`) // ?x=text%3F -->


<!-- 🧠 Super Simple Explanation

👉 Pagination appends URL so the server knows:

Which page you want

What filters/search you are using

🧩 Without URL append (What happens)

Click Next → server forgets state → resets to page 1.

🧩 With URL append (Correct)

Click Next → server keeps state → shows correct page. -->